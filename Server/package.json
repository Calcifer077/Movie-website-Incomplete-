{
  "name": "moviessite",
  "version": "1.0.0",
  "description": "Movie review website",
  "main": "app.js",
  "scripts": {
    "start": "nodemon server.js",
    "start:prod": "cross-env NODE_ENV=production nodemon server.js",
    "debug": "ndb server.js",
    "watch:js": "parcel watch ./public/js/index.js --out-dir ./public/js --out-file bundle.js --public-url /js",
    "build:js": "parcel build ./public/js/index.js --out-dir ./public/js/bundled"
  },
  "author": "Mahesh",
  "license": "ISC",
  "devDependencies": {
    "@parcel/transformer-sass": "^2.12.0",
    "@types/dotenv": "^6.1.1",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.7",
    "parcel-bundler": "^1.12.5",
    "prettier": "3.2.5"
  },
  "dependencies": {
    "@babel/polyfill": "^7.4.4",
    "axios": "^1.7.5",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.19.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.4",
    "core-js": "^3.37.1",
    "cors": "^2.8.5",
    "dotenv": "^7.0.0",
    "express": "^4.16.4",
    "fractional": "^1.0.0",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^8.9.5",
    "morgan": "^1.9.1",
    "nodemailer": "^6.1.1",
    "pug": "^3.0.3",
    "regenerator-runtime": "^0.14.1",
    "validator": "^10.11.0"
  },
  "engines": {
    "node": "^18"
  }
}
