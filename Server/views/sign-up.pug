extend base

block content
    .overlay
        // Sign-up-container starts here
        .sign-up-container
            .sign-up-container-header
                img.icons(src='/Images/Icons/icons8-close.svg', alt='')
            .sign-up-container-header-text
                span.special-green-text Join today!
            // Sign-up-container-buttons-starts here
            .sign-up-container-buttons
                .sign-up-btn-google.sign-up-btns
                    img.icons(src='/Images/Icons/icons8-google.svg', alt='')
                    span Sign up with google
                .sign-up-btn-email.sign-up-btns
                    a(href='/sign-up-email')
                        img.icons(src='/Images/Icons/icons8-email-48.png', alt='')
                        span Sign up with email
                .sign-up-btn-microsoft.sign-up-btns
                    img.icons(src='/Images/Icons/icons8-microsoft.svg', alt='')
                    span Sign up with microsoft
                // Sign-up-containers-buttons ends here
                .sign-up-already-have-a-account
                    | Already have a account?
                    a(href='/login')
                        span.special-green-text Sign In
                .sign-up-container-text
                    | By clicking &quot;Sign-Up&quot; you are accepting to our terms and services
        // Sign-up-container ends here